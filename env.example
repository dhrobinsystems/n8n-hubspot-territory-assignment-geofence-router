# =============================================================================
# n8n-hubspot-territory-assignment-geofence-router — environment template
# Set these on the n8n host/container (read through $env). Never commit real values.
# Values that still start with YOUR_ are treated as "not set".
# License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
# =============================================================================

# --- Safety (SAFE DEFAULTS — keep them on until you have tested) ----------------
# true = compute and report routing decisions; never change record owners.
DRY_RUN=true
# true = abort unless the HubSpot portal's accountType is SANDBOX or DEVELOPER_TEST.
SANDBOX_MODE=true
# false = only assign records that have no owner yet.
OVERWRITE_EXISTING_OWNER=false
# Records processed per execution (1-1000); the rest of a large payload is rejected.
MAX_RECORDS_PER_EXECUTION=100
# contacts | companies | contacts,companies
ALLOWED_OBJECT_TYPES=contacts,companies

# --- HubSpot ------------------------------------------------------------------
# Private App access token (HubSpot retired legacy API keys).
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#         crm.objects.companies.read, crm.objects.companies.write
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
HUBSPOT_API_BASE=https://api.hubapi.com

# --- Inbound webhook ------------------------------------------------------------
# Required for webhook runs: send as the x-router-token header (or ?token=).
ROUTER_WEBHOOK_TOKEN=YOUR_ROUTER_WEBHOOK_TOKEN

# --- Matching -----------------------------------------------------------------
# Signals in priority order; the first signal with a match decides.
MATCH_ORDER=polygon,postal,area_code,country
# Calling code assumed for phone numbers written without +country code.
DEFAULT_PHONE_COUNTRY_CODE=1
# HubSpot property names used as routing inputs.
COUNTRY_PROPERTY=country
POSTAL_PROPERTY=zip
PHONE_PROPERTIES=phone,mobilephone
# Optional: properties holding coordinates for polygon matching (set both or neither).
LATITUDE_PROPERTY=
LONGITUDE_PROPERTY=
# Owner property to write, and an optional custom property that records the territory ID.
OWNER_PROPERTY=hubspot_owner_id
ROUTING_AUDIT_PROPERTY=
# Optional numeric HubSpot owner ID for records no territory matches.
FALLBACK_OWNER_ID=YOUR_FALLBACK_OWNER_ID
# Optional: full territory config as single-line JSON (overrides the Territory Rules node).
TERRITORY_CONFIG_JSON=

# --- Notifications --------------------------------------------------------------
# Slack-compatible incoming webhook for run reports and error alerts (optional).
NOTIFY_WEBHOOK_URL=YOUR_WEBHOOK_URL
NOTIFY_ON_DRY_RUN=true
